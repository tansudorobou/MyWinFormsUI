<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Description>Code-first Windows Forms components, automatic layouts, searchable model tables, charts, Gantt schedules, questionnaires and replaceable JSON themes with optional rounded corners.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/tansudorobou/MyWinFormsUI</RepositoryUrl>
    <PackageTags>winforms;ui;components;templates</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../themes/*.json" Pack="true" PackagePath="contentFiles/any/any/themes/" PackageCopyToOutput="true" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <None Include="../../components.json" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
